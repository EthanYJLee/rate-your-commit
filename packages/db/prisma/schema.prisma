// RateYourCommit core data model — see docs/ARCHITECTURE.md §3.
// Field names are deliberately plain-language: a non-developer admin
// should be able to read this file and understand what's tracked.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A real individual in the organization. The canonical entity that
/// all scattered git identities get merged into via S-07.
model Person {
  id          String     @id @default(cuid())
  displayName String
  employeeId  String?    @unique
  identities  Identity[]
  scores      ScoreResult[]
  auditLogs   IdentityAuditLog[]
  /// AppUser accounts (email/password sign-in) linked to this real
  /// person, admin-assigned on /settings/app-users — convenience only
  /// (a "내 스코어카드" quick link), not an access restriction; see
  /// AppUser.personId's doc comment.
  appUsers    AppUser[]
  /// Null until an admin assigns one on /settings/teams — no
  /// connector reports team membership, so this is manual-only.
  team        Team?      @relation(fields: [teamId], references: [id])
  teamId      String?
  createdAt   DateTime   @default(now())
}

/// Manually-managed organizational grouping (S-01's team-comparison
/// view). No source connector reports this — GitHub repos/issues
/// don't map to org teams — so membership is admin-assigned on
/// /settings/teams, not synced.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  people    Person[]
  createdAt DateTime @default(now())
}

enum IdentityStatus {
  confirmed
  pending
  shared_account
  unresolved
}

/// One git-author identity (name + email combo) as it literally
/// appears in commit history. Many can map to one Person.
model Identity {
  id        String         @id @default(cuid())
  handle    String
  email     String?
  status    IdentityStatus @default(pending)
  person    Person?        @relation(fields: [personId], references: [id])
  personId  String?
  commits   Commit[]
  /// Tickets this identity is the (primary) GitHub assignee for —
  /// see GitHubIssuesConnector / RawTicket.assigneeHandle.
  tickets   Ticket[]
  auditLogs IdentityAuditLog[]
  createdAt DateTime       @default(now())

  @@unique([handle, email])
}

/// Append-only history of every S-07 identity→person link change
/// (merge, unmerge, or a shared-account split creating a new
/// identity). The first place in this codebase that records "who did
/// this" — actorLogin is the signed-in GitHub login, not a Person FK,
/// since sessions aren't linked to a Person (JWT-only auth, no User
/// table — see docs/ARCHITECTURE.md §1).
model IdentityAuditLog {
  id               String    @id @default(cuid())
  action           String    // "merge" | "unmerge" | "split"
  identity         Identity  @relation(fields: [identityId], references: [id])
  identityId       String
  person           Person?   @relation(fields: [personId], references: [id])
  personId         String?
  previousPersonId String?
  actorLogin       String
  /// e.g. the extracted [태그] name for a "split" action.
  note             String?
  createdAt        DateTime  @default(now())
}

model Project {
  id                String   @id @default(cuid())
  name              String
  connectorId       String   // e.g. "github", "gitlab"
  externalRef       String   // e.g. "org/repo"
  difficultyFactor  Float    @default(1.0)
  commits           Commit[]
  tickets           Ticket[]
  createdAt         DateTime @default(now())

  @@unique([connectorId, externalRef])
}

model Commit {
  id            String    @id @default(cuid())
  sha           String
  message       String
  additions     Int
  deletions     Int
  authoredAt    DateTime
  /// Set true when this commit is excluded from scoring (e.g. a
  /// 12M-line "restore" commit) — see docs/ARCHITECTURE.md §4.
  excludedFlag  Boolean   @default(false)
  excludedReason String?
  identity      Identity  @relation(fields: [identityId], references: [id])
  identityId    String
  project       Project   @relation(fields: [projectId], references: [id])
  projectId     String

  @@unique([projectId, sha])
}

model Ticket {
  id         String    @id @default(cuid())
  externalId String
  title      String
  status     String
  createdAt  DateTime
  closedAt   DateTime?
  project    Project   @relation(fields: [projectId], references: [id])
  projectId  String
  /// The (primary) assignee, when the source connector reports one.
  /// Null when unassigned — see S-02 delivery-axis aggregation, which
  /// can only attribute a ticket to a person once this is set.
  identity   Identity? @relation(fields: [identityId], references: [id])
  identityId String?

  @@unique([projectId, externalId])
}

/// Organization-configurable weights fed into
/// packages/scoring#calculateScore. Never hardcoded — always read
/// from here.
model ScoreWeightConfig {
  id             String   @id @default(cuid())
  organizationId String
  delivery       Float
  quality        Float
  collaboration  Float
  evaluation     Float
  effectiveFrom  DateTime @default(now())
}

/// A computed, immutable snapshot of one person's score for one
/// period. Recomputable at any time from Commit/Ticket data plus the
/// ScoreWeightConfig in effect — never edited in place.
model ScoreResult {
  id           String   @id @default(cuid())
  person       Person   @relation(fields: [personId], references: [id])
  personId     String
  periodStart  DateTime
  periodEnd    DateTime
  delivery     Float
  quality      Float
  collaboration Float
  evaluation   Float
  finalScore   Float
  grade        String
  calculatedAt DateTime @default(now())

  @@unique([personId, periodStart, periodEnd])
}

/// An email/password sign-in credential — additive to GitHub OAuth,
/// not a replacement (see auth.ts). NOT an Auth.js Adapter "User":
/// this app still uses JWT sessions with no Adapter, so there's
/// deliberately no Account/Session/VerificationToken table alongside
/// this one — just a lookup row for the Credentials provider's
/// authorize() callback. Admin-provisioned only (see
/// /settings/app-users) — no public self-registration, matching the
/// same fail-closed philosophy as ALLOWED_GITHUB_LOGINS. Not linked
/// to Person; that's a separate, not-yet-built concern.
model AppUser {
  id           String      @id @default(cuid())
  email        String      @unique
  /// scrypt(password, salt), stored as "saltHex:hashHex" — see
  /// apps/web/lib/password.ts. Never a plaintext password.
  passwordHash String
  /// admin/member RBAC (see apps/web/lib/request-guard.ts for what
  /// each level can reach). Defaults to "member" for newly-created
  /// rows going forward — the /settings/app-users creation form lets
  /// an existing admin explicitly pick "admin" instead. The migration
  /// that introduced this column backfilled every pre-existing row to
  /// "admin", since they were provisioned back when the app had no
  /// role concept at all and already had full access.
  role         AppUserRole @default(member)
  /// Null until an admin links this account to a real Person on
  /// /settings/app-users. Convenience only — surfaces a "내 스코어카드"
  /// link on the dashboard for the linked person; unrelated to `role`
  /// above, which IS the access-control mechanism.
  person       Person?     @relation(fields: [personId], references: [id])
  personId     String?
  createdAt    DateTime    @default(now())
}

enum AppUserRole {
  admin
  member
}
