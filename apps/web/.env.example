# Next.js only auto-loads .env files from its OWN directory (apps/web/),
# not the monorepo root — copy this to apps/web/.env for `npm run dev -w apps/web`.
# (docker-compose.yml doesn't need this file: it injects the root .env
# directly into the container's environment via `env_file: .env`.)

DATABASE_URL=postgres://rateyourcommit:change-me@localhost:5432/rateyourcommit

# --- App ---
NEXTAUTH_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required when self-hosting behind a reverse proxy (nginx, Caddy,
# Traefik, a cloud load balancer, etc.) — without this, Auth.js v5
# often rejects the callback because it doesn't trust the proxy's
# forwarded host/proto headers by default. Not needed for local `next dev`.
AUTH_TRUST_HOST=true

# --- Auth: two sign-in methods, additive — enable either or both ---
# 1) GitHub OAuth. Register an OAuth App at
#    https://github.com/settings/developers; callback URL is
#    {NEXT_PUBLIC_APP_URL}/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub usernames allowed to sign in. Fails CLOSED:
# leaving this blank means nobody can sign in, not everybody.
ALLOWED_GITHUB_LOGINS=
# Comma-separated subset of ALLOWED_GITHUB_LOGINS granted the "admin"
# role (access to /identities and /settings/*; everyone else gets
# read-only /scorecard access — see apps/web/lib/request-guard.ts).
# OPPOSITE default direction from ALLOWED_GITHUB_LOGINS above: leaving
# this blank grandfathers EVERY allowed login to admin (the
# non-breaking default), rather than locking everyone to member.
ADMIN_GITHUB_LOGINS=

# 2) Email/password (Credentials provider). No self-registration —
#    admin-provisioned only, from /settings/app-users once you have an
#    admin account. If you don't want to use GitHub OAuth at all,
#    bootstrap your first admin from the command line instead:
#      npm run create-admin -w packages/db -- you@example.com
#    (prompts for a password; see packages/db/scripts/create-admin.ts)
