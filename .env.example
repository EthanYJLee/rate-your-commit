# --- Database ---
POSTGRES_USER=rateyourcommit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rateyourcommit
DATABASE_URL=postgres://rateyourcommit:change-me@localhost:5432/rateyourcommit

# --- GitHub connector (v1.0) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=       # "owner/repo" — the repo apps/worker syncs

# --- Optional AI-assist features (see docs/AI-POLICY.md) ---
# Leave both blank to disable AI-assist features entirely.
# Set one of the two depending on your data policy:
AI_ASSIST_PROVIDER=          # "local" | "anthropic" | ""
AI_ASSIST_API_KEY=           # required only if AI_ASSIST_PROVIDER=anthropic
AI_ASSIST_LOCAL_ENDPOINT=    # required only if AI_ASSIST_PROVIDER=local

# --- App ---
NEXTAUTH_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
