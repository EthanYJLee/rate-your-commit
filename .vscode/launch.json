{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug web (dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Worker: debug sync (dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Scoring: run tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/scoring",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest", "run"],
      "console": "integratedTerminal"
    }
  ]
}
